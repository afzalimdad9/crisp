# Port the API listens on (Vercel sets PORT automatically).
PORT=8787

# Postgres connection string. Leave EMPTY to use the in-memory store (local dev).
# On Vercel, set this to the Postgres plugin's connection string.
DATABASE_URL=

# The macOS app's bundle id — the audience the Apple identity token must match.
APPLE_BUNDLE_ID=com.wisedt.WiseEdit

# Secret used to sign our own session JWTs. Use a long random value in prod.
JWT_SECRET=dev-secret-change-me

# Deepgram API key. Leave EMPTY locally to use a deterministic MOCK transcription.
DEEPGRAM_API_KEY=

# Free cloud minutes granted to each new account.
FREE_MINUTES=10

# Dev only: set to 1 to enable POST /v1/auth/dev (issues a session token without
# Apple sign-in, for local testing). MUST stay 0 in production.
DEV_AUTH=0
